{
  "name": "brikelec-puzzle",
  "productName": "La centrale du futur",
  "version": "1.0.0",
  "description": "La centrale du futur : jeu de puzzle CIPREL pour borne tactile hors ligne.",
  "author": "CIPREL",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "svg:build": "node scripts/build-svg.mjs",
    "svg:check": "node scripts/compare.mjs",
    "kiosk:dev": "nuxt generate && electron .",
    "kiosk:build": "nuxt generate && electron-builder --win --x64"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "gsap": "^3.15.0",
    "jpeg-js": "^0.4.4",
    "nuxt": "^4.6.2",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "build": {
    "appId": "ci.ciprel.centrale-du-futur",
    "productName": "La centrale du futur",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**",
      ".output/public/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "La-centrale-du-futur-TEST-PC-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "La centrale du futur",
      "artifactName": "La-centrale-du-futur-BORNE-Setup-${version}.${ext}"
    }
  }
}
